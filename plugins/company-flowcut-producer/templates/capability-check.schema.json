{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/company-flowcut-producer/capability-check.schema.json",
  "title": "Company FlowCut Producer capability and plan preflight",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capability_check_version",
    "provider",
    "operation",
    "feature_key",
    "project_id",
    "requested_parameters",
    "status",
    "source",
    "checked_at",
    "plan",
    "evidence"
  ],
  "properties": {
    "capability_check_version": { "const": "1.0" },
    "provider": { "type": "string", "minLength": 1 },
    "operation": { "type": "string", "minLength": 1 },
    "feature_key": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "requested_parameters": { "type": "object", "minProperties": 1 },
    "status": { "enum": ["available", "not_included", "unknown", "error"] },
    "source": {
      "enum": ["provider_preflight", "read_only_entitlement", "submit_gate", "manual_admin"]
    },
    "checked_at": { "type": "string", "format": "date-time" },
    "plan": { "type": "object" },
    "evidence": { "type": "object" }
  },
  "not": {
    "properties": {
      "status": { "const": "available" },
      "source": { "const": "submit_gate" }
    },
    "required": ["status", "source"]
  }
}
