{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://company.invalid/schemas/remix-template.schema.json",
  "title": "Company Video Remix Template",
  "type": "object",
  "additionalProperties": false,
  "required": ["template_version", "template_id", "display_name", "revision", "status", "product_scope", "match", "max_outputs", "max_asset_uses", "shots", "variants"],
  "properties": {
    "template_version": {"const": "1.0"},
    "template_id": {"type": "string", "minLength": 1},
    "display_name": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "status": {"enum": ["draft", "approved", "disabled"]},
    "product_scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platforms", "aspect_ratios", "languages", "duration_seconds", "tags"],
      "properties": {
        "platforms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "aspect_ratios": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["9:16", "16:9", "1:1", "4:5"]}},
        "languages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "duration_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 600},
        "tags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "max_outputs": {"type": "integer", "minimum": 1, "maximum": 100},
    "max_asset_uses": {"type": "integer", "minimum": 1, "maximum": 20},
    "shots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slot_id", "line_slot", "role", "duration_seconds", "required_categories", "required_tags", "preferred_tags", "allowed_media_types", "required_orientation", "preferred_orientation", "fit_mode", "allow_generic"],
        "properties": {
          "slot_id": {"type": "string", "minLength": 1},
          "line_slot": {"type": "string", "minLength": 1},
          "role": {"enum": ["hook", "problem", "product", "feature", "proof", "scene", "cta", "transition", "audio"]},
          "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
          "required_categories": {"type": "array", "uniqueItems": true, "items": {"enum": ["product_hero", "product_detail", "feature_proof", "usage_scene", "problem_context", "lifestyle", "presenter", "reference_only", "audio_music", "audio_voice", "audio_sfx", "transition", "uncategorized"]}},
          "required_tags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "preferred_tags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "allowed_media_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["image", "video", "audio"]}},
          "required_orientation": {"enum": ["portrait", "landscape", "square", "unknown", "any"]},
          "preferred_orientation": {"enum": ["portrait", "landscape", "square", "unknown", "any"]},
          "fit_mode": {"enum": ["contain", "cover", "cover_blur_background"]},
          "allow_generic": {"type": "boolean"}
        },
        "anyOf": [
          {"properties": {"required_categories": {"minItems": 1}}},
          {"properties": {"required_tags": {"minItems": 1}}}
        ]
      }
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["variant_id", "name", "shot_order"],
        "properties": {
          "variant_id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "shot_order": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "notes": {"type": "string"}
  }
}
