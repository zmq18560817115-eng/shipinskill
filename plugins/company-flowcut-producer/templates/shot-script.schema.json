{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://company.invalid/schemas/shot-script.schema.json",
  "title": "Script To Material Matching Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["script_version", "script_id", "product_id", "aspect_ratio", "target_duration_seconds", "max_asset_uses", "shots"],
  "properties": {
    "script_version": {"const": "1.0"},
    "script_id": {"type": "string", "minLength": 1},
    "product_id": {"type": "string", "minLength": 1},
    "aspect_ratio": {"enum": ["9:16", "16:9", "1:1", "4:5"]},
    "target_duration_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 600},
    "max_asset_uses": {"type": "integer", "minimum": 1, "maximum": 20},
    "selection_seed": {"type": "integer", "minimum": 0, "maximum": 999999},
    "shots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["shot_id", "order", "line", "role", "duration_seconds", "required_categories", "required_tags", "preferred_tags", "allowed_media_types", "required_orientation", "preferred_orientation", "fit_mode", "allow_generic", "fact_refs"],
        "properties": {
          "shot_id": {"type": "string", "minLength": 1},
          "order": {"type": "integer", "minimum": 1},
          "line": {"type": "string", "minLength": 1},
          "role": {"enum": ["hook", "problem", "product", "feature", "proof", "scene", "cta", "transition", "audio"]},
          "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
          "required_categories": {"type": "array", "uniqueItems": true, "items": {"enum": ["product_hero", "product_detail", "feature_proof", "usage_scene", "problem_context", "lifestyle", "presenter", "reference_only", "audio_music", "audio_voice", "audio_sfx", "transition", "uncategorized"]}},
          "required_tags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "preferred_tags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "allowed_media_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["image", "video", "audio"]}},
          "required_orientation": {"enum": ["portrait", "landscape", "square", "unknown", "any"]},
          "preferred_orientation": {"enum": ["portrait", "landscape", "square", "unknown", "any"]},
          "fit_mode": {"enum": ["contain", "cover", "cover_blur_background"]},
          "allow_generic": {"type": "boolean"},
          "fact_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
